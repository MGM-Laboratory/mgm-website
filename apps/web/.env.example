NEXT_PUBLIC_API_URL=http://localhost:4000/api
CMS_API_URL=http://localhost:4000/api
ADMIN_PASSPHRASE=change-this-before-production

# Optional: enables the interactive map on event detail pages. Without it,
# the page falls back to an address + "Open in Google Maps" link.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Largest accepted job application CV upload, in bytes (100 MB by default)
CMS_MAX_CV_BYTES=104857600

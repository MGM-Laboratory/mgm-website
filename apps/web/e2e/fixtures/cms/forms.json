      "document": {
        "version": 1,
        "title": "Lab open day sign-up",
        "description": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Sign up for the MGM Laboratory open day."
                }
              ]
            }
          ]
        },
        "fields": [
          {
            "id": "intro",
            "type": "heading",
            "label": "About you",
            "required": false,
            "width": "full",
            "headingLevel": 2
          },
          {
            "id": "name",
            "type": "short_text",
            "label": "What should we call you?",
            "placeholder": "Your first name",
            "required": true,
            "width": "half"
          },
          {
            "id": "email",
            "type": "email",
            "label": "Your email",
            "placeholder": "name@example.com",
            "required": true,
            "width": "half"
          },
          {
            "id": "role",
            "type": "multiple_choice",
            "label": "Which describes you best?",
            "required": true,
            "width": "full",
            "options": [
              {
                "id": "student",
                "label": "Student"
              },
              {
                "id": "staff",
                "label": "Lab staff"
              },
              {
                "id": "visitor",
                "label": "Visitor"
              }
            ],
            "allowOther": true
          },
          {
            "id": "why",
            "type": "long_text",
            "label": "What do you hope to learn, {{name}}?",
            "required": false,
            "width": "full",
            "visibleIf": {
              "match": "all",
              "rules": [
                {
                  "subject": "role",
                  "operator": "equals",
                  "value": "student"
                }
              ]
            },
            "maxLength": 280
          },
          {
            "id": "ref",
            "type": "hidden",
            "label": "Referral",
            "required": false,
            "width": "full",
            "prefillParam": "ref"
          },
          {
            "id": "p2",
            "type": "page_break",
            "label": "",
            "required": false,
            "width": "full",
            "pageTitle": "Your visit",
            "pageDescription": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Tell us what you would like to see."
                    }
                  ]
                }
              ]
            },
            "jumps": [
              {
                "id": "skip",
                "when": {
                  "match": "all",
                  "rules": [
                    {
                      "subject": "role",
                      "operator": "equals",
                      "value": "staff"
                    }
                  ]
                },
                "to": "p3"
              }
            ]
          },
          {
            "id": "excitement",
            "type": "rating",
            "label": "How excited are you?",
            "required": false,
            "width": "full",
            "max": 5,
            "ratingIcon": "star"
          },
          {
            "id": "topics",
            "type": "checkboxes",
            "label": "Which demos interest you?",
            "required": false,
            "width": "full",
            "options": [
              {
                "id": "games",
                "label": "Games"
              },
              {
                "id": "web",
                "label": "Websites"
              },
              {
                "id": "mobile",
                "label": "Mobile apps"
              },
              {
                "id": "ux",
                "label": "UX research"
              }
            ],
            "maxSelections": 2
          },
          {
            "id": "p3",
            "type": "page_break",
            "label": "",
            "required": false,
            "width": "full",
            "pageTitle": "Almost there"
          },
          {
            "id": "photos",
            "type": "yes_no",
            "label": "May we photograph you on the day?",
            "required": true,
            "width": "full"
          },
          {
            "id": "consent",
            "type": "consent",
            "label": "Privacy",
            "required": true,
            "width": "full",
            "consentText": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I agree that MGM Laboratory keeps my answers to plan the open day."
                    }
                  ]
                }
              ]
            }
          }
        ],
        "welcome": {
          "enabled": true,
          "eyebrow": "Open day 2026",
          "title": "Come build something with us",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A few questions so we can plan your visit. Every answer adds a piece to the picture."
                  }
                ]
              }
            ]
          },
          "buttonLabel": "Let's begin",
          "showDuration": true,
          "showQuestionCount": true
        },
        "endings": [
          {
            "id": "default",
            "title": "Thank you, {{name}}",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Your seat is saved. We will email the details a week before the day."
                    }
                  ]
                }
              ]
            },
            "showScore": false,
            "allowAnother": true,
            "showShare": true
          },
          {
            "id": "staff",

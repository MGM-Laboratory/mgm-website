              "match": "all",
              "rules": [
                {
                  "subject": "role",
                  "operator": "equals",
                  "value": "staff"
                }
              ]
            },
            "title": "See you backstage",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Thanks for helping out. The crew list is on its way."
                    }
                  ]
                }
              ]
            },
            "showScore": false,
            "allowAnother": false,
            "showShare": true
          }
        ],
        "design": {

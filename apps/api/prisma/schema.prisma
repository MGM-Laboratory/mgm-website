generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CmsMember {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsArticle {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsPublication {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsAdmin {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsJobPosting {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsJobApplication {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsResearchInitiative {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton record — always read/written at slug "contact". Reuses the same
// slug + data Json shape as the other collections purely for consistency;
// there is only ever one row.
model CmsContactSettings {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton record — always read/written at slug "home". Same slug + data
// Json shape as the other collections purely for consistency (see
// CmsContactSettings); there is only ever one row.
model CmsHomeContent {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsProject {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsEvent {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsEventRegistration {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsContactInquiry {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Live counters for "calendar" window mail-provider limits — one row per
// provider id ("resend" | "smtp" | "ses"). Separate from CmsContactSettings
// because these need atomic increment/decrement under concurrent contact
// form submissions, which a JSON settings blob can't give safely.
model MailProviderUsage {
  provider       String    @id
  dailyRemaining Int?
  dailyResetAt   DateTime?
  longRemaining  Int?
  longResetAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

// One row per send, for "rolling" window mail-provider limits — remaining
// quota is derived by counting rows in the trailing window at check time,
// rather than a stored counter, so it reflects only what this app actually
// sent. Pruned opportunistically past the longest configured rolling window.
model MailSendLog {
  id       String   @id @default(uuid())
  provider String
  sentAt   DateTime @default(now())

  @@index([provider, sentAt])
}

// Single-row cursor for the loadBalanceEqual strategy's round-robin pointer.
model MailRoutingState {
  key   String @id
  value Int    @default(0)
}

// One row per domain a short link can be served from: the site's own domain
// (isPrimary, links live under /s/:slug) or a custom domain added by an
// admin (links live at the domain root). Custom domains point at the web
// service via CNAME and are only served once they verify.
model ShortLinkDomain {
  id          String   @id @default(cuid())
  hostname    String   @unique
  isPrimary   Boolean  @default(false)
  // "local" (the site domain), "cloudflare" (DNS hosted on Cloudflare),
  // or "manual" (any other provider).
  provider String @default("manual")
  // "pending" until the domain answers the verification marker.
  status  String    @default("pending")
  cloudflareZoneId        String?
  cloudflareTokenEncrypted String?
  // Random token checked in the _mgm-verify TXT record that the Domain
  // Connect sync writes, which is what domain validity checks look for.
  verifyToken   String?
  // The Railway custom-domain id, when the domain was attached to the web
  // service through the Railway API (needs RAILWAY_API_TOKEN).
  railwayDomainId String?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  links           ShortLink[]
}

model ShortLink {
  id       String @id @default(cuid())
  slug     String
  longUrl  String
  domainId String
  domain   ShortLinkDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  // null means the link never expires; maxClicks caps total clicks ("once").
  expiresAt DateTime?
  maxClicks Int?
  clickCount Int     @default(0)
  viewCount  Int     @default(0)
  passphraseSalt String?
  passphraseHash String?
  // Lazy health check of longUrl, refreshed when the admin lists links.
  longUrlStatus    String?
  longUrlCheckedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  visits           ShortLinkVisit[]

  @@unique([domainId, slug])
  @@index([domainId, createdAt])
}

model ShortLinkVisit {
  id        String @id @default(cuid())
  linkId    String
  link      ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  referer   String?
  // A view is a gate page render, a click is an actual redirect; a link
  // without a passphrase records both on its single request.
  isView        Boolean @default(true)
  isClick       Boolean @default(false)
  failedAttempt Boolean @default(false)
  country       String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  timezone      String?
  device        String?
  browser       String?
  os            String?
  createdAt     DateTime @default(now())

  @@index([linkId, createdAt])
}

// --- Forms ---
// A form built in the admin workspace: the whole design lives in `data`
// (the shared FormDocument, validated on every write). Responses, traffic
// events and respondent uploads hang off it and go with it on delete.
model Form {
  id     String @id @default(cuid())
  slug   String @unique
  // draft | published | closed
  status String @default("draft")
  data   Json
  passphraseSalt String?
  passphraseHash String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  responses      FormResponse[]
  events         FormEvent[]
  uploads        FormUpload[]
}

model FormResponse {
  id        String  @id @default(cuid())
  formId    String
  form      Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers   Json
  score     Float?
  endingId  String?
  sessionId String?
  deviceId  String?
  // Honeypot filled or faster than the form's minSeconds.
  spam      Boolean @default(false)
  ip        String?
  userAgent String?
  referer   String?
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  timezone  String?
  device    String?
  browser   String?
  os        String?
  language  String?
  screen    String?
  utm       Json?
  startedAt  DateTime?
  durationMs Int?
  starred   Boolean  @default(false)
  flagged   Boolean  @default(false)
  reviewed  Boolean  @default(false)
  tags      String[] @default([])
  note      String?
  editedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([formId, deviceId])
}

model FormEvent {
  id        String  @id @default(cuid())
  formId    String
  form      Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  sessionId String
  // view | start | progress | submit
  type      String
  fieldId   String?
  // sessionId:type:fieldId, so a reload never counts a session twice.
  dedupeKey String
  ip        String?
  userAgent String?
  referer   String?
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  device    String?
  browser   String?
  os        String?
  language  String?
  createdAt DateTime @default(now())

  @@unique([formId, dedupeKey])
  @@index([formId, createdAt])
  @@index([formId, type])
}

// A respondent's file, stored before the response exists; `responseId` is
// set when a submission claims it, unclaimed rows are swept after a day.
model FormUpload {
  key        String   @id
  formId     String
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  fieldId    String
  sessionId  String?
  name       String
  size       Int
  type       String
  width      Int?
  height     Int?
  responseId String?
  createdAt  DateTime @default(now())

  @@index([formId, createdAt])
  @@index([responseId])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CmsMember {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsArticle {
  slug      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

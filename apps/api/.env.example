NODE_ENV=development
PORT=4000

# Postgres connection string used by Prisma. Add the password of your local database after the user name when it needs one.
DATABASE_URL=postgresql://postgres@localhost:5432/mgm_website?schema=public

# Only needed to run `prisma migrate dev`/`migrate diff` locally (schema-diffing
# needs a disposable database). Point this at an empty db your role can create
# tables in - Prisma creates/drops it on its own. Not needed for `migrate deploy`
# or normal app runtime.
SHADOW_DATABASE_URL=postgresql://postgres@localhost:5432/mgm_website_shadow?schema=public

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# The public web app's own origin - used to build absolute asset/link URLs
# (logo, footer links) in outgoing emails.
PUBLIC_WEB_URL=http://localhost:3000

# Rate limiting (ms, request count)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# The proxies in front of the API whose x-forwarded-for is believed. Leave it unset when only the web server calls the API. A number is
# a count of proxy hops, and a list is addresses, ranges or the words loopback, linklocal and uniquelocal. Never set it to true.
# TRUST_PROXY=
# Required, no default. Create it with `openssl rand -hex 64`.
ADMIN_PASSPHRASE=

# The inbox that receives contact-form submissions is CMS-configurable
# (Contact Settings in /admin), not an env var — it's business data, not a secret.

# AWS (S3 uploads + SES email) — leave blank locally if unused
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for an S3-compatible provider other than real AWS (e.g. MinIO or Cloudflare R2)
AWS_ENDPOINT_URL=
AWS_S3_FORCE_PATH_STYLE=
SES_FROM_EMAIL=

# Alternative email providers, checked in order Resend -> SMTP -> SES (default).
# Leave both blank to send through AWS SES above.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Largest accepted publication paper upload, in bytes (200 MB by default)
CMS_MAX_PAPER_BYTES=209715200

# Largest accepted project demo video upload, in bytes (500 MB by default)
CMS_MAX_VIDEO_BYTES=524288000

# Largest accepted job application CV upload, in bytes (100 MB by default)
CMS_MAX_CV_BYTES=104857600

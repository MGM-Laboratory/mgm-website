NODE_ENV=development
PORT=4000

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/website?schema=public

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting (ms, request count)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
ADMIN_PASSPHRASE=change-this-before-production

# AWS (S3 uploads + SES email) — leave blank locally if unused
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for an S3-compatible provider other than real AWS (e.g. Railway buckets)
AWS_ENDPOINT_URL=
AWS_S3_FORCE_PATH_STYLE=
SES_FROM_EMAIL=

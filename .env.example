# Used by docker-compose for the local Postgres container and the api/web
# containers. For direct `pnpm dev:*` work, copy each workspace's own
# .env.example into apps/api/.env and apps/web/.env instead.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=website
POSTGRES_PORT=5432

# Used only as the image namespace when docker-compose builds the local stack.
DOCKERHUB_NAMESPACE=your-dockerhub-username

# API container configuration.
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
ADMIN_PASSPHRASE=change-this-before-production

# Optional object storage and AWS SES. The current compose file passes these
# five variables to the API; without a bucket, file uploads are unavailable.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Web image build argument. CMS_API_URL is intentionally internal in compose
# (`http://api:4000/api`) and is supplied by docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

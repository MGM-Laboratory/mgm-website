# Used by docker-compose for the local Postgres container and the api/web
# containers. For direct `pnpm dev:*` work, copy each workspace's own
# .env.example into apps/api/.env and apps/web/.env instead.

POSTGRES_USER=postgres
# Required. Create it with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=mgm_website
POSTGRES_PORT=5432

# Used only as the image namespace when docker-compose builds the local stack.
DOCKERHUB_NAMESPACE=your-dockerhub-username

# API container configuration.
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# The proxies in front of the API whose x-forwarded-for is believed. Leave it unset when only the web server calls the API. A number is
# a count of proxy hops, and a list is addresses, ranges or the words loopback, linklocal and uniquelocal. Never set it to true.
# TRUST_PROXY=
# Required, no default. Create it with `openssl rand -hex 64`.
ADMIN_PASSPHRASE=

# Required, at least 32 characters, no default. Create it with `openssl rand -hex 64`. The API signs the form unlock tokens with it and the web
# app signs the admin session with it, so it has to be the same value for both. A new value ends every session and every unlock token.
SESSION_SECRET=

# Optional object storage and AWS SES. The current compose file passes these
# five variables to the API; without a bucket, file uploads are unavailable.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Web image build argument. CMS_API_URL is intentionally internal in compose
# (`http://api:4000/api`) and is supplied by docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Link shortener (docs/shortlinks.md). The primary domain serves /s/:slug
# links. Custom short domains CNAME to the target, which is the public
# hostname of the proxy in front of the web app. Leave it empty until you
# have one, the admin UI then says the CNAME target is not configured.
SHORTLINKS_PRIMARY_DOMAIN=labmgm.org
SHORTLINKS_CNAME_TARGET=
# 32-byte hex key for Cloudflare API tokens at rest (openssl rand -hex 32).
SHORTLINKS_ENCRYPTION_KEY=

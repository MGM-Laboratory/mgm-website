# Used by docker-compose for the local Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=website
POSTGRES_PORT=5432

# DockerHub namespace used by docker-compose.yml and CI to tag/push images
DOCKERHUB_NAMESPACE=your-dockerhub-username

# AWS SES sends the contact form's email (and other transactional mail); AWS
# S3 stores uploaded files (contact attachments, CMS media). Both use the
# same credentials. SES_FROM_EMAIL must be a verified SES sender identity.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SES_FROM_EMAIL=

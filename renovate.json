{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "assignees": ["SyafaHadyan"],
  "dependencyDashboard": true,
  "automerge": false,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "build"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"],
    "semanticCommitType": "fix",
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "semanticCommitType": "ci"
    },
    {
      "description": "the images of the lint tools run in the workflows and never ship, so they take the commit type of the workflows",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".github/tools/Dockerfile"],
      "semanticCommitType": "ci",
      "groupName": "Lint tool images",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["npm", "nvm", "docker-compose"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["apps/web/package.json"],
      "groupName": "web non-major dependencies",
      "groupSlug": "web-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["apps/api/package.json"],
      "groupName": "api non-major dependencies",
      "groupSlug": "api-minor-patch"
    },
    {
      "description": "the turbo version of the app Dockerfiles is a build input of the images, so it takes the commit type of the packages",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["apps/api/Dockerfile", "apps/web/Dockerfile"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["npm", "custom.regex"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "the base images of the app Dockerfiles are part of the app images, so they take the commit type of the packages",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["apps/api/Dockerfile", "apps/web/Dockerfile"],
      "semanticCommitType": "build",
      "groupName": "Dockerfile base images",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "matchDepNames": ["node"],
      "allowedVersions": "22.x"
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "tool versions in workflow files that sit under a renovate comment",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*[A-Za-z0-9_]+: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "tool versions in the app Dockerfiles that sit under a renovate comment",
      "managerFilePatterns": ["/^apps/(api|web)/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\nARG [A-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "minimumReleaseAgeBehaviour": "timestamp-optional"
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "assignees": ["SyafaHadyan"],
  "dependencyDashboard": true,
  "automerge": false,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "build"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"],
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["apps/web/package.json"],
      "groupName": "web non-major dependencies",
      "groupSlug": "web-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["apps/api/package.json"],
      "groupName": "api non-major dependencies",
      "groupSlug": "api-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": ["apps/web/package.json", "apps/api/package.json"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "the images of .github/tools/Dockerfile are the tools that CI starts from a workflow, so they take the commit type of the workflows",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".github/tools/Dockerfile"],
      "semanticCommitType": "ci"
    },
    {
      "description": "the base images of the app Dockerfiles are part of the app images, so they take the commit type of the packages",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["apps/api/Dockerfile", "apps/web/Dockerfile"],
      "semanticCommitType": "build",
      "groupName": "Dockerfile base images",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchDepNames": ["node"],
      "matchManagers": ["dockerfile"],
      "allowedVersions": "22.x"
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "the tools that CI starts from a workflow, such as ls-lint and Renovate itself, take the commit type of the workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci"
    }
  ],
  "customManagers": [
    {
      "description": "A version in a workflow that the line above names with a renovate comment, which the bot cannot find in a run step or an action input otherwise",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:version|[A-Z][A-Z0-9_]*_VERSION): [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}

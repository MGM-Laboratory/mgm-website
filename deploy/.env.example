# The settings of the production example, copied to the server as .env next to compose.yml. Every copy of the API loads this
# whole file, and the web copies get only ADMIN_PASSPHRASE and the address of the API from it. See docs/deployment.md and
# docs/configuration.md for every setting of the apps.

# The version that runs, as 1.2.3 without the v. rolling-update.sh sets it on every update.
IMAGE_TAG=
DOCKERHUB_NAMESPACE=labmgm

# The address and the host ports of the four copies. The default address is the loopback address of the host, so only a reverse
# proxy on the same host reaches them. Set it to another address of the host when the proxy runs somewhere else.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
API_1_HOST_PORT=4010
API_2_HOST_PORT=4011
WEB_1_HOST_PORT=3010
WEB_2_HOST_PORT=3011

# Limits of one copy, and the size of the log files that Docker keeps for it.
API_CPUS=1.00
API_MEMORY_LIMIT=768m
WEB_CPUS=1.00
WEB_MEMORY_LIMIT=512m
WEB_CACHE_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# The name of the Docker network of the shared database container. It has to exist already, compose never creates it.
DB_NETWORK=postgres_postgres

# Required. Create it with `openssl rand -hex 64`. The API checks it on every admin request and the web app signs the admin
# session with it, so it has to be the same value for both, and a new value ends every session.
ADMIN_PASSPHRASE=

# The database. Create the database and its user as docs/deployment.md says, and use a password from `openssl rand -hex 64`.
DATABASE_URL=postgresql://mgm_website_production_user:CHANGE_ME@postgres:5432/mgm_website_production?schema=public

# The public origin of the site, for the CORS check of the API and for the links in e-mails.
CORS_ORIGIN=https://example.org
PUBLIC_WEB_URL=https://example.org

# The rate limit of the API, as the number of requests in the window of milliseconds.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# The proxies in front of the API whose x-forwarded-for is believed. Leave it unset when only the web server calls the API. A number is
# a count of proxy hops, and a list is addresses, ranges or the words loopback, linklocal and uniquelocal. Never set it to true.
# TRUST_PROXY=

# Object storage and mail. Without a bucket, file uploads are unavailable. docs/mail-system.md explains the three mail providers.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# The link shortener, docs/shortlinks.md. A setting that has a default must not be set to an empty value, because the API
# refuses to start with an empty string, so delete the line instead.
SHORTLINKS_PRIMARY_DOMAIN=labmgm.org
SHORTLINKS_CNAME_TARGET=
# 32 bytes in hex, from `openssl rand -hex 32`.
SHORTLINKS_ENCRYPTION_KEY=

# The upload limits in bytes. The API and the web app check them both, and the compose file passes the same value to both. Raise
# API_MEMORY_LIMIT with them, because the API holds an upload in memory while it stores it. The values below are the defaults.
# CMS_MAX_PAPER_BYTES=209715200
# CMS_MAX_VIDEO_BYTES=524288000
# CMS_MAX_CV_BYTES=104857600
# FORMS_MAX_UPLOAD_BYTES=104857600
# The host names that serve short links at their root. The default is labmgm.org,www.labmgm.org.
# SHORTLINKS_SITE_HOSTS=labmgm.org,www.labmgm.org
